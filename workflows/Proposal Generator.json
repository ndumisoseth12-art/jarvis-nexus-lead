kground:linear-gradient(135deg,rgba(139,92,246,0.12),rgba(34,211,238,0.06));border:1px solid rgba(139,92,246,0.25);border-radius:14px;padding:24px;margin-bottom:28px;\">       <div style=\"font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:#8b5cf6;margin-bottom:14px;\">Next Steps</div>       <div style=\"font-size:14px;color:#a0a0c0;line-height:1.8;\">         1. Reply to this email with any questions<br>         2. Book a free 10-minute demo call to see it live<br>         3. Confirm and we go live within 48 hours       </div>     </div>      <!-- CTA -->     <div style=\"text-align:center;margin-bottom:32px;\">       <a href=\"https://cal.com/seth-mokone-limbt0/30min\" style=\"display:inline-block;background:linear-gradient(135deg,#8b5cf6,#3b82f6,#22d3ee);color:#fff;font-weight:800;padding:16px 36px;border-radius:14px;text-decoration:none;font-size:15px;box-shadow:0 8px 30px rgba(139,92,246,0.3);\">Book Your Free Demo Call →</a>       <div style=\"font-size:12px;color:#a0a0c0;margin-top:12px;\">Or reply to this email · WhatsApp: +27 67 099 4163</div>     </div>      <!-- FOOTER -->     <div style=\"border-top:1px solid rgba(255,255,255,0.08);padding-top:20px;text-align:center;font-size:12px;color:#a0a0c0;line-height:1.7;\">       Seth · NSM · ndumisoseth12@gmail.com · +27 67 099 4163<br>       <span style=\"color:#8b5cf6;font-weight:600;\">AI Automation for South African Businesses</span>     </div>    </div> </div> </body> </html>",
