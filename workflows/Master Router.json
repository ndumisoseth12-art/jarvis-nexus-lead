    {
      "parameters": {
        "promptType": "define",
        "text": "=={{ 'Classify this message into ONE category.\\n\\nCategories:\\n- review: mentions reviews, Google reviews, ratings, testimonials, review response\\n- lead: new customer enquiry, pricing, wants to sign up, join NSM\\n- support: existing customer needs help, has an issue, technical problem\\n- airbnb: Airbnb guest review, host review, holiday rental\\n- reactivation: win back, lost customer, dormant customers, been a while, silent\\n- reputation: post-sale feedback, unhappy customer, complaints, bad experience, service recovery\\n- referral: refers a friend, referral programme, earn credit, invite\\n- noshow: appointment, booking, missed appointment, no-show, rescheduling\\n- general: anything else\\n\\nRespond ONLY with this exact JSON, no markdown:\\n{\"category\": \"review\", \"urgency\": \"high\", \"summary\": \"one sentence\"}\\n\\nName: ' + $json['name'] + '\\nEmail: ' + $json['email'] + '\\nMessage: ' + $json['message'] }}",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        640,
        0
      ],
