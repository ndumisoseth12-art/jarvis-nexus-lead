    {
      "parameters": {
        "jsCode": "const name = $('Edit Fields').item.json['name'] || 'Unknown';\nconst email = $('Edit Fields').item.json['email'] || 'unknown@email.com';\nconst message = $('Edit Fields').item.json['message'] || 'No message';\n\nconst rawText = $input.item.json['output'] || '';\n\nconst cleaned = rawText\n  .replace(/```json/g, '')\n  .replace(/```/g, '')\n  .trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch(e) {\n  const match = cleaned.match(/\\{[\\s\\S]*\\}/);\n  if (match) {\n    try { parsed = JSON.parse(match[0]); }\n    catch(e2) { parsed = { category: 'general', urgency: 'low', summary: 'Parse error' }; }\n  } else {\n    parsed = { category: 'general', urgency: 'low', summary: 'Parse error' };\n  }\n}\n\nreturn {\n  name: name,\n  email: email,\n  message: message,\n  category: parsed['category'] || 'general',\n  urgency: parsed['urgency'] || 'low',\n  summary: parsed['summary'] || 'No summary'\n};"
      },
