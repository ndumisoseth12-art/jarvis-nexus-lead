        0,
        0
      ],
      "id": "b13a1b2c-d4e5-f6a7-b8c9-d0e1f2c13001",
      "name": "Webhook — PayFast ITN",
      "webhookId": "b13-payfast-itn"
    },
    {
      "parameters": {
        "jsCode": "// B13 PayFast Listener — Build signature verification string + extract fields.\n// Hashing happens in the next node (Crypto).\n//\n// LIVE PASSPHRASE — read from Railway env var PAYFAST_PASSPHRASE.\n// Set it in Railway BEFORE flipping MODE to 'live'. If not set in live mode,\n// every signature check will fail and Seth gets a Telegram alert on the first ITN.\n\n// ============ MODE — must match B12 ============\nconst MODE = 'live'; // 'sandbox' (PayFast public test passphrase) or 'live' (Railway env)\n// ================================================\nconst PASSPHRASE = MODE === 'live'\n  ? ($env['PAYFAST_PASSPHRASE'] || '')\n  : 'jt7NOE43FZPn';\n\nconst body = $input.item.json['body'] || {};\n\n// PayFast URL encoding: must match PHP urlencode() exactly.\nfunction pfEncode(value) {\n  return encodeURIComponent(String(value).trim())\n    .replace(/%20/g, '+')\n    .replace(/!/g, '%21')\n    .replace(/'/g, '%27')\n    .replace(/\\(/g, '%28')\n    .replace(/\\)/g, '%29')\n    .replace(/\\*/g, '%2A')\n    .replace(/~/g, '%7E');\n}\n\nconst keys = Object.keys(body).filter(k => k !== 'signature');\nconst queryString = keys.map(k => k + '=' + pfEncode(body[k])).join('&');\nconst stringToHash = PASSPHRASE\n  ? queryString + '&passphrase=' + pfEncode(PASSPHRASE)\n  : queryString;\n\nconst providedSig = body['signature'] || '';\n\n// Extract useful fields for downstream nodes\nconst paymentStatus = body['payment_status'] || 'UNKNOWN';\nconst paymentId     = body['m_payment_id']   || '';\nconst pfPaymentId   = body['pf_payment_id']  || '';\nconst itemName      = body['item_name']      || '';\nconst tierKey       = body['custom_str1']    || '';\nconst amount        = body['amount_gross']   || body['amount'] || '0';\nconst customerEmail = body['email_address']  || 'ndumisoseth12@gmail.com';\nconst customerName  = (body['name_first'] || '') + (body['name_last'] ? ' ' + body['name_last'] : '');\nconst tokenId       = body['token']          || '';\nconst billingDate   = body['billing_date']   || '';\n\n// Renewal vs initial discriminator.\n// IMPORTANT: PayFast DOES send billing_date on the initial signup ITN too — it's the date\n// of the NEXT recurring charge, not a renewal marker. Originally we OR'd billing_date in,\n// which made every initial signup misfire to the renewal branch (welcome email never sent).\n// The only reliable signal is item_name: PayFast prepends 'Subscription payment for '\n// on recurring ITNs and leaves the merchant-supplied item_name untouched on the initial.\nconst isRenewal = /subscription payment for/i.test(itemName);\n\nreturn [{\n  json: {\n    stringToHash: stringToHash,\n    providedSig: providedSig,\n    paymentStatus: paymentStatus,\n    paymentId: paymentId,\n    pfPaymentId: pfPaymentId,\n    tierKey: tierKey,\n    tierLabel: tierKey ? (tierKey.charAt(0).toUpperCase() + tierKey.slice(1)) : 'Unknown',\n    itemName: itemName,\n    amount: amount,\n    customerEmail: customerEmail,\n    customerName: customerName.trim() || 'New Customer',\n    firstName: (customerName.split(' ')[0] || 'there').trim(),\n    tokenId: tokenId,\n    billingDate: billingDate,\n    isRenewal: isRenewal,\n    billingType: isRenewal ? 'renewal' : 'initial',\n    receivedAt: $now.setZone('Africa/Johannesburg').toFormat('yyyy-MM-dd HH:mm:ss')\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "id": "b13a1b2c-d4e5-f6a7-b8c9-d0e1f2c13002",
      "name": "Code — Prepare Verification"
    },
    {
      "parameters": {
