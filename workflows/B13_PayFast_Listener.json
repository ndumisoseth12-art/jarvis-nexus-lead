      "name": "Crypto — Compute MD5"
    },
    {
      "parameters": {
        "jsCode": "// B13 — Compare expected signature with provided signature\n\nconst d = $input.item.json;\nconst signatureValid = d['expectedSig'] === d['providedSig'];\n\nreturn [{ json: { ...d, signatureValid: signatureValid } }];"
      },
