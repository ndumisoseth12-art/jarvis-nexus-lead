      "parameters": {
        "jsCode": "const d = $('Edit Fields').item.json;\n\n// Invoice number — timestamp based\nconst now = new Date();\nconst pad = n => String(n).padStart(2, '0');\nconst invoiceNumber = 'JN-' + now.getFullYear() + pad(now.getMonth() + 1) + pad(now.getDate()) + '-' + Math.floor(Math.random() * 900 + 100);\n\n// Dates\nconst issueDate = now.toLocaleDateString('en-ZA', { day: '2-digit', month: 'long', year: 'numeric' });\nconst dueDate = new Date(now.getTime() + 7 * 24 * 60 * 60 * 1000)\n  .toLocaleDateString('en-ZA', { day: '2-digit', month: 'long', year: 'numeric' });\n\n// Amounts\nconst setupFee   = parseFloat(d['setupFee'])   || 0;\nconst monthlyFee = parseFloat(d['monthlyFee']) || 0;\nconst totalDue   = setupFee + monthlyFee;\n\nconst formatRand = n => 'R' + n.toLocaleString('en-ZA', { minimumFractionDigits: 2 });\n\n// Bot list for itemisation\nconst bots = (d['botsSelected'] || '').split(',').map(b => b.trim()).filter(Boolean);\nconst botRows = bots.map(bot =>\n  '<tr><td style=\"padding:10px 0;border-bottom:1px solid #1a1a2e;color:#a0a0c0;font-size:14px;\">' + bot + ' — AI Automation Bot</td><td style=\"padding:10px 0;border-bottom:1px solid #1a1a2e;text-align:right;color:#ffffff;font-size:14px;\">Included</td></tr>'\n).join('');\n\n// Full HTML invoice\nconst invoiceHTML = `\n<!DOCTYPE html>\n<html>\n<head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1.0\"></head>\n<body style=\"margin:0;padding:0;background:#f4f6fa;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;\">\n<div style=\"max-width:600px;margin:40px auto;background:#020208;border-radius:20px;overflow:hidden;border:1px solid rgba(255,255,255,0.1);\">\n\n  <!-- HEADER -->\n  <div style=\"padding:36px 40px;background:linear-gradient(135deg,#8b5cf6,#3b82f6,#22d3ee);position:relative;\">\n    <div style=\"font-size:24px;font-weight:800;color:#fff;letter-spacing:1px;\">NSM</div>\n    <div style=\"font-size:11px;color:rgba(255,255,255,0.7);letter-spacing:3px;text-transform:uppercase;margin-top:4px;\">AI Automation Platform</div>\n    <div style=\"position:absolute;top:36px;right:40px;text-align:right;\">\n      <div style=\"font-size:11px;color:rgba(255,255,255,0.7);letter-spacing:2px;text-transform:uppercase;\">Invoice</div>\n      <div style=\"font-size:20px;font-weight:800;color:#fff;margin-top:4px;\">${invoiceNumber}</div>\n    </div>\n  </div>\n\n  <!-- BODY -->\n  <div style=\"padding:40px;\">\n\n    <!-- BILL TO / FROM -->\n    <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:40px;margin-bottom:36px;\">\n      <div>\n        <div style=\"font-size:10px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:#8b5cf6;margin-bottom:10px;\">Bill To</div>\n        <div style=\"font-size:16px;font-weight:700;color:#ffffff;\">${d['clientName']}</div>\n        <div style=\"font-size:14px;color:#a0a0c0;margin-top:4px;\">${d['businessName']}</div>\n        <div style=\"font-size:14px;color:#a0a0c0;margin-top:2px;\">${d['email']}</div>\n        <div style=\"font-size:14px;color:#a0a0c0;margin-top:2px;\">${d['phone'] || ''}</div>\n      </div>\n      <div>\n        <div style=\"font-size:10px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:#8b5cf6;margin-bottom:10px;\">From</div>\n        <div style=\"font-size:16px;font-weight:700;color:#ffffff;\">Seth — NSM</div>\n        <div style=\"font-size:14px;color:#a0a0c0;margin-top:4px;\">ndumisoseth12@gmail.com</div>\n        <div style=\"font-size:14px;color:#a0a0c0;margin-top:2px;\">+27 67 099 4163</div>\n        <div style=\"font-size:14px;color:#a0a0c0;margin-top:2px;\">South Africa</div>\n      </div>\n    </div>\n\n    <!-- DATES -->\n    <div style=\"display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;margin-bottom:36px;\">\n      <div style=\"background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);border-radius:12px;padding:16px;\">\n        <div style=\"font-size:10px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:#a0a0c0;margin-bottom:6px;\">Issue Date</div>\n        <div style=\"font-size:13px;font-weight:600;color:#ffffff;\">${issueDate}</div>\n      </div>\n      <div style=\"background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);border-radius:12px;padding:16px;\">\n        <div style=\"font-size:10px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:#a0a0c0;margin-bottom:6px;\">Due Date</div>\n        <div style=\"font-size:13px;font-weight:600;color:#f59e0b;\">${dueDate}</div>\n      </div>\n      <div style=\"background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);border-radius:12px;padding:16px;\">\n        <div style=\"font-size:10px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:#a0a0c0;margin-bottom:6px;\">Status</div>\n        <div style=\"font-size:13px;font-weight:700;color:#f59e0b;\">Payment Due</div>\n      </div>\n    </div>\n\n    <!-- LINE ITEMS -->\n    <table style=\"width:100%;border-collapse:collapse;margin-bottom:28px;\">\n      <thead>\n        <tr>\n          <th style=\"text-align:left;font-size:10px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:#8b5cf6;padding-bottom:12px;border-bottom:1px solid rgba(139,92,246,0.3);\">Description</th>\n          <th style=\"text-align:right;font-size:10px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:#8b5cf6;padding-bottom:12px;border-bottom:1px solid rgba(139,92,246,0.3);\">Amount</th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr>\n          <td style=\"padding:14px 0;border-bottom:1px solid #1a1a2e;color:#ffffff;font-size:15px;font-weight:600;\">${d['plan']}</td>\n          <td style=\"padding:14px 0;border-bottom:1px solid #1a1a2e;text-align:right;color:#ffffff;font-size:15px;font-weight:600;\"></td>\n        </tr>\n        <tr>\n          <td style=\"padding:10px 0;border-bottom:1px solid #1a1a2e;color:#a0a0c0;font-size:14px;\">Once-off Setup Fee</td>\n          <td style=\"padding:10px 0;border-bottom:1px solid #1a1a2e;text-align:right;color:#ffffff;font-size:14px;\">${formatRand(setupFee)}</td>\n        </tr>\n        <tr>\n          <td style=\"padding:10px 0;border-bottom:1px solid #1a1a2e;color:#a0a0c0;font-size:14px;\">Monthly Retainer (Month 1)</td>\n          <td style=\"padding:10px 0;border-bottom:1px solid #1a1a2e;text-align:right;color:#ffffff;font-size:14px;\">${formatRand(monthlyFee)}</td>\n        </tr>\n        ${botRows}\n      </tbody>\n    </table>\n\n    <!-- TOTAL -->\n    <div style=\"background:linear-gradient(135deg,rgba(139,92,246,0.15),rgba(34,211,238,0.08));border:1px solid rgba(139,92,246,0.3);border-radius:14px;padding:24px;display:flex;justify-content:space-between;align-items:center;margin-bottom:32px;\">\n      <div style=\"font-size:14px;font-weight:600;color:#a0a0c0;letter-spacing:1px;text-transform:uppercase;\">Total Due</div>\n      <div style=\"font-size:32px;font-weight:800;background:linear-gradient(135deg,#8b5cf6,#22d3ee);-webkit-background-clip:text;-webkit-text-fill-color:transparent;\">${formatRand(totalDue)}</div>\n    </div>\n\n    <!-- BANKING DETAILS -->\n    <div style=\"background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.08);border-radius:14px;padding:24px;margin-bottom:32px;\">\n      <div style=\"font-size:10px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:#10b981;margin-bottom:16px;\">Banking Details — EFT Payment</div>\n      <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:12px;\">\n        <div>\n          <div style=\"font-size:10px;color:#a0a0c0;text-transform:uppercase;letter-spacing:1px;margin-bottom:3px;\">Bank</div>\n          <div style=\"font-size:14px;font-weight:600;color:#ffffff;\">Capitec</div>\n        </div>\n        <div>\n          <div style=\"font-size:10px;color:#a0a0c0;text-transform:uppercase;letter-spacing:1px;margin-bottom:3px;\">Account Name</div>\n          <div style=\"font-size:14px;font-weight:600;color:#ffffff;\">NS Mokone</div>\n        </div>\n        <div>\n          <div style=\"font-size:10px;color:#a0a0c0;text-transform:uppercase;letter-spacing:1px;margin-bottom:3px;\">Account Number</div>\n          <div style=\"font-size:14px;font-weight:600;color:#ffffff;\">1760852196</div>\n        </div>\n        <div>\n          <div style=\"font-size:10px;color:#a0a0c0;text-transform:uppercase;letter-spacing:1px;margin-bottom:3px;\">Branch Code</div>\n          <div style=\"font-size:14px;font-weight:600;color:#ffffff;\">470010</div>\n        </div>\n        <div>\n          <div style=\"font-size:10px;color:#a0a0c0;text-transform:uppercase;letter-spacing:1px;margin-bottom:3px;\">Reference</div>\n          <div style=\"font-size:14px;font-weight:600;color:#f59e0b;\">${invoiceNumber}</div>\n        </div>\n      </div>\n    </div>\n\n    <!-- FOOTER NOTE -->\n    <div style=\"text-align:center;font-size:12px;color:#a0a0c0;line-height:1.6;\">\n      Payment is due within 7 days of this invoice.<br>\n      Questions? Reply to this email or WhatsApp +27 67 099 4163<br><br>\n      <span style=\"color:#8b5cf6;font-weight:600;\">Thank you for choosing NSM.</span>\n    </div>\n\n  </div>\n</div>\n</body>\n</html>\n`;\n\nreturn [{\n  json: {\n    invoiceNumber,\n    issueDate,\n    dueDate,\n    setupFee: formatRand(setupFee),\n    monthlyFee: formatRand(monthlyFee),\n    totalDue: formatRand(totalDue),\n    totalDueRaw: totalDue,\n    invoiceHTML,\n    clientName:    d['clientName'],\n    businessName:  d['businessName'],\n    email:         d['email'],\n    phone:         d['phone'],\n    plan:          d['plan'],\n    botsSelected:  d['botsSelected']\n  }\n}];"
      },
