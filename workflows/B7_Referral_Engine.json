        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"llama-3.3-70b-versatile\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You write warm, personal referral-ask emails for South African businesses. The customer just had a positive experience and you want to ask them to refer a friend. Rules:\\n\\n1. ADDRESS by first name only.\\n2. ACKNOWLEDGE the relationship genuinely. Never desperate.\\n3. EXPLAIN what their friend gets, what they get back. Both rewards clearly.\\n4. ONE clear ask. No begging.\\n5. Reference their tier or last product if relevant.\\n6. SIGN with the business name.\\n7. Under 90 words. Plain text. South African English.\\n\\nTone by tier:\\nVIP/Gold = warm, premium, treat them as the connector they are.\\nSilver/Bronze = friendly, helpful, low-key ask.\\n\\nRespond ONLY with a valid JSON object in this exact format with no markdown and no extra text: {\\\"subject\\\": \\\"short subject under 10 words\\\", \\\"body\\\": \\\"the email body\\\"}\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"First Name: {{ $json['firstName'] }}\\nTier: {{ $json['tier'] }}\\nBusiness: {{ $json['businessName'] }}\\nLast product: {{ $json['lastProduct'] }}\\nAdvocate gets: {{ $json['advocateReward'] }}\\nFriend gets: {{ $json['friendOffer'] }}\"\n    }\n  ],\n  \"temperature\": 0.6,\n  \"max_tokens\": 350\n}",
        "options": {}
      },
