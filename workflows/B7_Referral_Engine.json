    {
      "parameters": {
        "jsCode": "const promptVersion = 'b7-referral-v1';\n// B7 Referral Engine — Parse AI output, merge with setup\nconst rawText = $input.item.json['rawAIText'] || '';\nconst d = $('Edit Fields — Setup').item.json;\n\nconst cleaned = rawText.replace(/```json/g, '').replace(/```/g, '').trim();\nlet parsed;\ntry { parsed = JSON.parse(cleaned); }\ncatch (e) {\n  const m = cleaned.match(/\\{[\\s\\S]*\\}/);\n  if (m) { try { parsed = JSON.parse(m[0]); } catch (e2) { parsed = null; } }\n}\nif (!parsed || !parsed['body']) {\n  parsed = {\n    subject: 'A small thank-you and a favour from ' + d['businessName'],\n    body: 'Hi ' + d['firstName'] + ', thank you for being a great customer. If you know someone who would also enjoy ' + d['businessName'] + ', would you share us? They get ' + d['friendOffer'] + ' and you get ' + d['advocateReward'] + ' once they make their first purchase. Thanks for the support.'\n  };\n}\nconst parseSuccess = !!parsed['body'] && parsed['subject'] !== ('A small thank-you and a favour from ' + d['businessName']);\nreturn { ...d, promptVersion, subject: parsed['subject'], body: parsed['body'], parseSuccess };"
      },
