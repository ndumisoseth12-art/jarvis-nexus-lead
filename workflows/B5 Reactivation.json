      "parameters": {
        "jsCode": "const promptVersion = 'b5-react-v1';\n// B5 Reactivation — Parse AI output, merge with customer data\nconst rawText = $input.item.json['rawAIText'] || '';\nconst c = $('Code — Filter Eligible Customers').item.json;\n\nconst cleaned = rawText.replace(/```json/g, '').replace(/```/g, '').trim();\nlet parsed;\ntry { parsed = JSON.parse(cleaned); }\ncatch (e) {\n  const m = cleaned.match(/\\{[\\s\\S]*\\}/);\n  if (m) { try { parsed = JSON.parse(m[0]); } catch (e2) { parsed = null; } }\n}\nif (!parsed || !parsed['body']) {\n  parsed = {\n    subject: 'We miss you at ' + c['businessName'],\n    body: 'Hi ' + c['firstName'] + ', it has been a while since we last heard from you at ' + c['businessName'] + '. We would love to welcome you back — please enjoy ' + c['incentive'] + ' on your next order. Thank you for being part of our journey.'\n  };\n}\nconst parseSuccess = !!parsed['body'] && parsed['subject'] !== ('We miss you at ' + c['businessName']);\n\nreturn { ...c, promptVersion, subject: parsed['subject'], body: parsed['body'], parseSuccess, sentAt: $now.setZone('Africa/Johannesburg').toFormat('yyyy-MM-dd HH:mm:ss') };"
      },
