        "jsCode": "// B5 Reactivation — Aggregate campaign summary\nconst items = $input.all();\nconst total = items.length;\nif (total === 0) return [{ json: { campaignId: 'NONE', total: 0, summary: 'No eligible customers found.' } }];\n\nconst first = items[0].json;\nconst byTier = {};\nlet totalLTV = 0;\nfor (const i of items) {\n  const t = i.json['tier'] || 'Bronze';\n  byTier[t] = (byTier[t] || 0) + 1;\n  totalLTV += parseFloat(i.json['ltv']) || 0;\n}\n\nreturn [{\n  json: {\n    campaignId: first['campaignId'],\n    ownerEmail: first['ownerEmail'],\n    businessName: first['businessName'],\n    incentive: first['incentive'],\n    total,\n    totalLTV: Math.round(totalLTV),\n    byTier,\n    sentAtSAST: $now.setZone('Africa/Johannesburg').toFormat('yyyy-MM-dd HH:mm:ss')\n  }\n}];"
      },
