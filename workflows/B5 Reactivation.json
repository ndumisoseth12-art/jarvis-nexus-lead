      "parameters": {
        "jsCode": "// B5 Reactivation — Filter for silent-60d+ customers\nconst items = $input.all();\nconst trig = $('Edit Fields — Campaign Setup').item.json;\nconst minDays = trig['minDaysSilent'] || 60;\nconst now = new Date();\n\nconst eligible = [];\n\nfor (const item of items) {\n  const c = item.json || {};\n  const lastPurchase = c['Last Purchase Date'] || c['Last Updated'];\n  if (!lastPurchase) continue;\n  const lastDate = new Date(lastPurchase);\n  if (isNaN(lastDate.getTime())) continue;\n  const daysSilent = Math.floor((now - lastDate) / (1000 * 60 * 60 * 24));\n  if (daysSilent < minDays) continue;\n\n  const tier = c['Tier'] || 'Bronze';\n  const ltv = parseFloat(c['Lifetime Value'] || c['Total Spend'] || 0);\n  const totalPurchases = parseInt(c['Total Purchases'] || 0);\n\n  // Skip very low-value customers — not worth the email\n  if (ltv < 500 || totalPurchases < 2) continue;\n\n  eligible.push({\n    customerEmail: c['Customer Email'] || '',\n    customerName: c['Customer Name'] || 'Customer',\n    firstName: (c['Customer Name'] || 'there').split(' ')[0],\n    tier,\n    ltv,\n    totalPurchases,\n    daysSilent,\n    lastProduct: c['Last Product'] || '',\n    businessName: trig['businessName'],\n    ownerEmail: trig['ownerEmail'],\n    incentive: trig['incentive'],\n    campaignId: trig['campaignId']\n  });\n}\n\n// Sort by LTV descending — highest-value silent customers first\neligible.sort((a, b) => b.ltv - a.ltv);\n\nreturn eligible.map(e => ({ json: e }));"
      },
      "type": "n8n-nodes-base.code",
