        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"llama-3.3-70b-versatile\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are an expert customer support manager for South African businesses. Analyze the customer message and respond following these rules:\\n\\n1. CATEGORY RULES:\\nComplaint = customer unhappy with product or service.\\nQuestion = customer needs information.\\nRefund = customer wants money back.\\nCompliment = customer is happy.\\n\\n2. URGENCY RULES:\\nHigh = angry customer, refund request, order not received, damaged product. Resolve within 2 hours.\\nMedium = general complaint, delivery delay. Resolve within 24 hours.\\nLow = question, compliment, general inquiry. Resolve within 48 hours.\\n\\n3. DRAFT REPLY RULES:\\nAlways address customer by name.\\nAcknowledge their specific issue — never be generic.\\nFor complaints and refunds — apologize sincerely and offer a clear next step.\\nFor questions — answer directly and helpfully.\\nFor compliments — be warm and grateful.\\nKeep reply under 80 words.\\nUse South African English.\\n\\nRespond ONLY with a valid JSON object in this exact format with no markdown and no extra text: {\\\"category\\\": \\\"Complaint\\\", \\\"urgency\\\": \\\"High\\\", \\\"sentiment\\\": \\\"Negative\\\", \\\"draft_reply\\\": \\\"professional reply here\\\", \\\"recommended_action\\\": \\\"Refund customer immediately\\\", \\\"resolution_time\\\": \\\"Within 2 hours\\\"}\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Customer Name: {{ $json['body']['data']['fields'].find(f => f['label'] === 'Full Name')?.['value'] ?? 'Unknown' }}\\nEmail: {{ $json['body']['data']['fields'].find(f => f['label'] === 'Email Address')?.['value'] ?? 'Unknown' }}\\nOrder Number: {{ $json['body']['data']['fields'].find(f => f['label'] === 'Order Number')?.['value'] ?? 'Not provided' }}\\nIssue Type: {{ $json['body']['data']['fields'].find(f => f['label'] === 'What can we help you with?')?.['options']?.find(o => o['id'] === $json['body']['data']['fields'].find(f => f['label'] === 'What can we help you with?')?.['value']?.[0])?.['text'] ?? 'Not provided' }}\\nMessage: {{ $json['body']['data']['fields'].find(f => f['label'] === 'Describe your issue')?.['value'] ?? 'No message provided' }}\"\n    }\n  ],\n  \"temperature\": 0.3,\n  \"max_tokens\": 512\n}",
        "options": {}
      },
