      "parameters": {
        "jsCode": "const fields = $('Webhook').item.json['body']['data']['fields'];\n\nfunction getFieldValue(label) {\n  const field = fields.find(f => f['label'] === label);\n  if (!field) return 'Not provided';\n  \n  if (field['type'] === 'MULTIPLE_CHOICE' && field['options'] && field['value']) {\n    const selectedId = Array.isArray(field['value']) ? field['value'][0] : field['value'];\n    const selectedOption = field['options'].find(o => o['id'] === selectedId);\n    return selectedOption ? selectedOption['text'] : 'Not provided';\n  }\n  \n  if (Array.isArray(field['value'])) {\n    return field['value'].join(', ') || 'Not provided';\n  }\n  \n  return field['value'] || 'Not provided';\n}\n\nconst body = $('Webhook').item.json['body'];\nconst fullName = body['fullName'] || 'Not provided';\nconst email = body['email'] || 'Not provided';\nconst orderNumber = body['orderNumber'] || 'Not provided';\nconst issueType = body['issueType'] || 'Not provided';\nconst issueDescription = body['issueDescription'] || 'Not provided';\n\nconst cleanedText = rawText\n  .replace(/```json/g, '')\n  .replace(/```/g, '')\n  .trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(cleanedText);\n} catch(e) {\n  parsed = {\n    category: \"Question\",\n    urgency: \"Medium\",\n    sentiment: \"Neutral\",\n    draft_reply: \"Thank you for contacting us. We have received your message and will get back to you shortly.\",\n    recommended_action: \"Follow up within 24 hours\",\n    resolution_time: \"Within 24 hours\"\n  };\n}\n\nconst urgency = parsed['urgency'] || 'Medium';\nconst category = parsed['category'] || 'Question';\n\nlet borderColor;\nlet emailPrefix;\nlet categoryEmoji;\nlet responseTime;\n\nif (urgency === 'High') {\n  borderColor = '#e74c3c';\n  emailPrefix = '🔴 URGENT Support Ticket';\n  categoryEmoji = '🚨';\n  responseTime = 'Respond within 2 hours';\n} else if (urgency === 'Medium') {\n  borderColor = '#f39c12';\n  emailPrefix = '🟡 Support Ticket';\n  categoryEmoji = '⚠️';\n  responseTime = 'Respond within 24 hours';\n} else {\n  borderColor = '#2ecc71';\n  emailPrefix = '🟢 Support Ticket';\n  categoryEmoji = '✅';\n  responseTime = 'Respond within 48 hours';\n}\n\nif (category === 'Complaint') {\n  categoryEmoji = '😠';\n} else if (category === 'Refund') {\n  categoryEmoji = '💰';\n} else if (category === 'Compliment') {\n  categoryEmoji = '😊';\n  borderColor = '#2ecc71';\n  emailPrefix = '🟢 Compliment Received';\n  responseTime = 'Respond within 48 hours';\n} else {\n  categoryEmoji = '❓';\n}\n\nreturn {\n  fullName: fullName,\n  email: email,\n  orderNumber: orderNumber,\n  issueType: issueType,\n  issueDescription: issueDescription,\n  category: category,\n  urgency: urgency,\n  sentiment: parsed['sentiment'] || 'Neutral',\n  draftReply: parsed['draft_reply'] || 'Thank you for contacting us.',\n  recommendedAction: parsed['recommended_action'] || 'Follow up',\n  resolutionTime: parsed['resolution_time'] || 'Within 24 hours',\n  borderColor: borderColor,\n  emailPrefix: emailPrefix,\n  categoryEmoji: categoryEmoji,\n  responseTime: responseTime,\n  submittedAt: new Date().toLocaleString('en-ZA', { timeZone: 'Africa/Johannesburg' })\n};"
      },
