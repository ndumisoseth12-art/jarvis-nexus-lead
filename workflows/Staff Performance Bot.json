    {
      "parameters": {
        "jsCode": "const rows = $input.all();\nconst now = new Date();\nconst weekNum = Math.ceil(now.getDate() / 7);\n\n// Filter this week only\nconst thisWeek = rows.filter(r =>\n  parseInt(r.json['Week Number']) === weekNum\n);\n\nif (!thisWeek.length) {\n  return [{ json: { hasData: false, message: 'No feedback this week.' } }];\n}\n\n// Group by staff member\nconst staffMap = {};\nthisWeek.forEach(r => {\n  const name = r.json['Staff Member'] || 'Unknown';\n  if (!staffMap[name]) {\n    staffMap[name] = { scores: [], feedbacks: [], flags: 0, ratings: [] };\n  }\n  staffMap[name].scores.push(parseFloat(r.json['AI Score']) || 0);\n  staffMap[name].ratings.push(parseFloat(r.json['Overall Rating']) || 0);\n  staffMap[name].feedbacks.push(r.json['Staff Feedback'] || '');\n  if (r.json['Flag'] === 'FLAGGED') staffMap[name].flags++;\n});\n\n// Calculate averages\nconst staffResults = Object.entries(staffMap).map(([name, data]) => {\n  const avgScore = (data.scores.reduce((a, b) => a + b, 0) / data.scores.length).toFixed(1);\n  const avgRating = (data.ratings.reduce((a, b) => a + b, 0) / data.ratings.length).toFixed(1);\n  return { name, avgScore: parseFloat(avgScore), avgRating: parseFloat(avgRating), flags: data.flags, totalFeedback: data.scores.length };\n});\n\n// Sort by score\nstaffResults.sort((a, b) => b.avgScore - a.avgScore);\n\nconst topPerformer = staffResults[0];\nconst lowestPerformer = staffResults[staffResults.length - 1];\nconst totalFlags = thisWeek.filter(r => r.json['Flag'] === 'FLAGGED').length;\nconst totalFeedback = thisWeek.length;\n\nconst summary = staffResults.map(s =>\n  s.name + ': AI score ' + s.avgScore + '/10, customer rating ' + s.avgRating + '/5, ' + s.totalFeedback + ' reviews, ' + s.flags + ' flags'\n).join('. ');\n\nconst businessName = thisWeek[0]?.json['Business Name'] || 'Your Business';\nconst ownerEmail = thisWeek[0]?.json['Owner Email'] || '';\n\nreturn [{\n  json: {\n    hasData: true,\n    businessName,\n    ownerEmail,\n    staffResults,\n    topPerformer,\n    lowestPerformer,\n    totalFlags,\n    totalFeedback,\n    summary\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
