    {
      "parameters": {
        "jsCode": "// B9 v3-003 — Find resolved tickets due for a satisfaction check (header-whitespace safe)\nconst trimKeys = (r) => { const out = {}; for (const [k, v] of Object.entries(r || {})) out[k.trim()] = v; return out; };\nconst rows = $input.all().map(i => trimKeys(i.json));\nconst setup = $('Edit Fields — Satisfaction Scanner Setup').item.json;\nconst now = new Date(setup['nowIso']);\n\nconst candidates = [];\nfor (const r of rows) {\n  if (!r['Ticket ID']) continue;\n  if (r['Status'] !== 'Resolved') continue;\n  if (r['Satisfaction Triggered'] === 'Yes') continue;\n  const resolvedAtStr = r['Resolved At'];\n  if (!resolvedAtStr) continue;\n  const resolvedAt = new Date(resolvedAtStr);\n  if (isNaN(resolvedAt.getTime())) continue;\n  const hoursSinceResolved = (now - resolvedAt) / (1000 * 60 * 60);\n  // Fire 48h+ after resolution, skip if >14 days stale\n  if (hoursSinceResolved < 48) continue;\n  if (hoursSinceResolved > 14 * 24) continue;\n  if (!r['Email']) continue;\n  if (!r['Name']) continue;\n  candidates.push({\n    ticketId: r['Ticket ID'],\n    customerName: r['Name'],\n    customerEmail: r['Email'],\n    orderNumber: r['Order No'] || '',\n    issueType: r['Issue Type'] || '',\n    category: r['Category'] || '',\n    originalSentiment: r['Sentiment'] || '',\n    resolvedAt: resolvedAtStr,\n    hoursSinceResolved: Math.round(hoursSinceResolved),\n    scanId: setup['scanId'],\n    nowIso: setup['nowIso']\n  });\n}\nreturn candidates.map(c => ({ json: c }));"
      },
