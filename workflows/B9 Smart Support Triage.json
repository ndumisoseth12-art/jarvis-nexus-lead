      "parameters": {
        "jsCode": "const promptVersion = 'b9-triage-v1';\n// B9 Smart Support Triage — Parser + SLA + Routing\nconst rawText = $input.item.json['rawAIText'] || '';\nconst body = $('Webhook — Support Intake').item.json['body'] || {};\nconst fields = (body['data'] && body['data']['fields']) || [];\n\nfunction tallyVal(label) {\n  const f = fields.find(x => x['label'] === label);\n  if (!f) return null;\n  if (f['type'] === 'MULTIPLE_CHOICE' && f['options'] && f['value']) {\n    const sel = Array.isArray(f['value']) ? f['value'][0] : f['value'];\n    const opt = f['options'].find(o => o['id'] === sel);\n    return opt ? opt['text'] : null;\n  }\n  if (Array.isArray(f['value'])) return f['value'].join(', ');\n  return f['value'] || null;\n}\n\nconst fullName = body['fullName'] || tallyVal('Full Name') || 'Unknown';\nconst email = body['email'] || tallyVal('Email') || 'unknown@email.com';\nconst orderNumber = body['orderNumber'] || tallyVal('Order Number') || 'N/A';\nconst issueType = body['issueType'] || tallyVal('Issue Type') || 'N/A';\nconst issueDescription = body['issueDescription'] || tallyVal('Issue Description') || '';\nconst firstName = (fullName || 'there').split(' ')[0];\n\nconst cleaned = rawText.replace(/```json/g, '').replace(/```/g, '').trim();\nlet parsed;\ntry { parsed = JSON.parse(cleaned); }\ncatch (e) {\n  const m = cleaned.match(/\\{[\\s\\S]*\\}/);\n  if (m) { try { parsed = JSON.parse(m[0]); } catch (e2) { parsed = null; } }\n}\nif (!parsed || !parsed['draft_reply']) {\n  parsed = {\n    category: 'Question', urgency: 'Medium', sentiment: 'Neutral',\n    draft_reply: 'Hi ' + firstName + ', thanks for getting in touch. We have received your message and will get back to you shortly.',\n    recommended_action: 'Manual review required — AI parse failed.',\n    escalate: false, resolution_time: '24 hours'\n  };\n}\nconst parseSuccess = parsed['recommended_action'] !== 'Manual review required — AI parse failed.';\n\nconst urgency = parsed['urgency'] || 'Medium';\nconst category = parsed['category'] || 'Question';\nconst sentiment = parsed['sentiment'] || 'Neutral';\nconst escalate = parsed['escalate'] === true;\n\nconst slaHours = urgency === 'High' ? 2 : (urgency === 'Medium' ? 24 : 48);\nconst slaWaitMs = slaHours * 60 * 60 * 1000;\nconst now = new Date();\nconst slaDeadline = new Date(now.getTime() + slaWaitMs);\n\nconst styling = {\n  High:   { borderColor: '#f43f5e', emoji: '🚨', prefix: '🚨 URGENT', responseTime: 'Respond within 2 hours' },\n  Medium: { borderColor: '#f59e0b', emoji: '⚠️', prefix: '⚠️ ATTENTION', responseTime: 'Respond within 24 hours' },\n  Low:    { borderColor: '#10b981', emoji: '✅', prefix: '✅ STANDARD', responseTime: 'Respond within 48 hours' }\n}[urgency] || { borderColor: '#6366f1', emoji: '📨', prefix: '📨 NEW', responseTime: 'Standard SLA' };\n\nconst categoryEmoji = { Complaint: '😠', Question: '❓', Refund: '💰', Compliment: '🎉', Other: '📨' }[category] || '📨';\nconst ticketId = 'TKT-' + Date.now().toString(36).toUpperCase();\n\nreturn { promptVersion,\n  ticketId, fullName, firstName, email, orderNumber, issueType, issueDescription,\n  category, urgency, sentiment, escalate,\n  draftReply: parsed['draft_reply'], recommendedAction: parsed['recommended_action'],\n  resolutionTime: parsed['resolution_time'] || styling.responseTime,\n  slaHours, slaWaitMs, slaDeadlineISO: slaDeadline.toISOString(),\n  borderColor: styling.borderColor, emailPrefix: styling.prefix,\n  categoryEmoji, responseTime: styling.responseTime,\n  parseSuccess,\n  submittedAt: now.toISOString(),\n  submittedAtSAST: now.toLocaleString('en-ZA', { timeZone: 'Africa/Johannesburg' })\n};"
      },
