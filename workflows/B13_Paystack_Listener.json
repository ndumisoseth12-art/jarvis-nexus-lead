    {
      "parameters": {
        "jsCode": "// B13 — Verify Paystack HMAC-SHA512 signature + extract fields\nconst crypto = require('crypto');\n\nconst body = $input.item.json['body'] || {};\nconst headers = $input.item.json['headers'] || {};\nconst recvSignature = headers['x-paystack-signature'] || headers['X-Paystack-Signature'] || '';\nconst secretKey = $env['PAYSTACK_SECRET_KEY'] || '';\n\nconst bodyString = JSON.stringify(body);\nconst expected = secretKey\n  ? crypto.createHmac('sha512', secretKey).update(bodyString).digest('hex')\n  : '';\nconst signatureValid = !!secretKey && !!recvSignature && expected === recvSignature;\n\nconst data = body['data'] || {};\nconst customer = data['customer'] || {};\nconst metadata = data['metadata'] || {};\n\n// --- Customer fields (smart fallback) ---\nconst _first = (customer['first_name'] || '').trim();\nconst _last = (customer['last_name'] || '').trim();\nconst fullName = (_first + ' ' + _last).trim();\nconst customerEmail = customer['email'] || '';\n\n// firstName: real first name OR empty (NOT email — used in templates with conditional fallback)\nconst firstName = _first || '';\n\n// customerName: real full name OR 'New Customer' (email shows separately on its own line — don't double up)\nconst customerName = fullName || 'New Customer';\n\n// --- Tier (capitalised, with sensible default) ---\nconst tierKey = (metadata['tier'] || '').toLowerCase();\nconst tierName = metadata['tierName'] || (tierKey ? (tierKey.charAt(0).toUpperCase() + tierKey.slice(1)) : 'Plan');\nconst itemName = 'NSM · ' + tierName + ' Plan';\n\n// --- Paid_at: ISO → SAST ---\nconst paidAtRaw = data['paid_at'] || '';\nlet paidAtSAST = '';\nif (paidAtRaw) {\n  try {\n    paidAtSAST = $now.constructor.fromISO(paidAtRaw).setZone('Africa/Johannesburg').toFormat('yyyy-MM-dd HH:mm:ss');\n  } catch (e) { paidAtSAST = paidAtRaw; }\n}\n\n// --- Renewal vs initial ---\n// charge.success with metadata.tier present → initial\n// charge.success without metadata (or invoice.payment_succeeded) → renewal\nconst event = body['event'] || '';\nconst isRenewal = event === 'invoice.payment_succeeded' || (event === 'charge.success' && !metadata['tier']);\n\nreturn {\n  signatureValid,\n  event,\n  reference: data['reference'] || '',\n  customerEmail,\n  customerName,\n  firstName,\n  hasFirstName: !!firstName,\n  amount: (data['amount'] || 0) / 100,\n  tier: tierKey,\n  tierName,\n  tierLabel: tierName.toUpperCase(),\n  itemName,\n  paystackId: data['id'] || '',\n  status: data['status'] || '',\n  channel: data['channel'] || '',\n  paidAt: paidAtSAST,\n  isRenewal,\n  billingType: isRenewal ? 'renewal' : 'initial',\n  loggedAt: $now.setZone('Africa/Johannesburg').toFormat('yyyy-MM-dd HH:mm:ss')\n};"
      },
