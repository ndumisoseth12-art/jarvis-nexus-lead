    {
      "parameters": {
        "jsCode": "const d = $('Edit Fields').item.json;\n\nconst now = new Date();\nconst dueDate = new Date(d['dueDate']);\nconst daysOverdue = Math.max(0, Math.floor((now - dueDate) / 86400000));\n\nconst invoiceAmount = parseFloat(d['invoiceAmount']) || 0;\nconst formatRand = n => 'R' + n.toLocaleString('en-ZA', { minimumFractionDigits: 2 });\n\nlet stage = 'Stage 1';\nlet urgency = 'Gentle';\nif (daysOverdue >= 21) { stage = 'Stage 3'; urgency = 'Final'; }\nelse if (daysOverdue >= 14) { stage = 'Stage 2'; urgency = 'Firm'; }\n\nreturn [{\n  json: {\n    ...d,\n    daysOverdue,\n    stage,\n    urgency,\n    invoiceAmountFormatted: formatRand(invoiceAmount),\n    invoiceAmount\n  }\n}];"
      },
